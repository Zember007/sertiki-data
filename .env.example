# Docker credentials for local development only. Copy this file to .env and change values.
RAW_MYSQL_DATABASE=raw_ilovefsa
RAW_MYSQL_USER=raw_reader
RAW_MYSQL_PASSWORD=change-me-raw-reader
RAW_MYSQL_ROOT_PASSWORD=change-me-raw-root
SERTIKI_POSTGRES_DATABASE=sertiki
SERTIKI_POSTGRES_USER=sertiki
SERTIKI_POSTGRES_PASSWORD=change-me-postgres

# Host connection strings used by the normalizer and API.
RAW_MYSQL_URL=mysql://raw_reader:change-me-raw-reader@localhost:3307/raw_ilovefsa
SERTIKI_DATABASE_URL=postgres://sertiki:change-me-postgres@localhost:5433/sertiki
NORMALIZER_BATCH_SIZE=5000
# Keep this at 0 for compact site enrichment. Immutable RAW dumps remain in
# backups/, while PostgreSQL stores only values needed for matching and proof.
# Set to 1 only when a separate investigation needs duplicate source strings.
NORMALIZER_RETAIN_RAW=0
API_HOST=0.0.0.0
API_PORT=3000

